#! /usr/local/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/usr/local/lib/ivl/system.vpi";
:vpi_module "/usr/local/lib/ivl/vhdl_sys.vpi";
:vpi_module "/usr/local/lib/ivl/vhdl_textio.vpi";
:vpi_module "/usr/local/lib/ivl/v2005_math.vpi";
:vpi_module "/usr/local/lib/ivl/va_math.vpi";
:vpi_module "/usr/local/lib/ivl/v2009.vpi";
S_0x340ea580 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x340ea710 .scope module, "test" "test" 3 1;
 .timescale 0 0;
v0x34121730_0 .var/i "i", 31 0;
v0x34121810_0 .var "in", 3 0;
v0x34121900_0 .net "out", 3 0, L_0x34121a00;  1 drivers
S_0x3410f740 .scope module, "inst" "top" 3 7, 4 2 0, S_0x340ea710;
 .timescale 0 0;
    .port_info 0 /INPUT 4 "bin_i";
    .port_info 1 /OUTPUT 4 "gray_o";
v0x341214f0_0 .net "bin_i", 3 0, v0x34121810_0;  1 drivers
v0x341215f0_0 .net "gray_o", 3 0, L_0x34121a00;  alias, 1 drivers
L_0x34121a00 .ufunc/vec4 TD_test.inst.bin2gray, 4, v0x34121810_0 (v0x340ea8a0_0) S_0x3410f920;
S_0x3410f920 .scope autofunction.vec4.s4, "bin2gray" "bin2gray" 4 8, 4 8 0, S_0x3410f740;
 .timescale 0 0;
v0x340ea8a0_0 .var "bin", 3 0;
; Variable bin2gray is vec4 return value of scope S_0x3410f920
TD_test.inst.bin2gray ;
    %load/vec4 v0x340ea8a0_0;
    %load/vec4 v0x340ea8a0_0;
    %ix/load 4, 1, 0;
    %flag_set/imm 4, 0;
    %shiftr 4;
    %xor;
    %ret/vec4 0, 0, 4;  Assign to bin2gray (store_vec4_to_lval)
    %disable/flow S_0x3410f920;
    %end;
    .scope S_0x340ea710;
T_1 ;
    %vpi_call/w 3 12 "$dumpfile", "dump.vcd" {0 0 0};
    %vpi_call/w 3 13 "$dumpvars", 32'sb00000000000000000000000000000001 {0 0 0};
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x34121730_0, 0, 32;
T_1.0 ;
    %load/vec4 v0x34121730_0;
    %cmpi/s 16, 0, 32;
    %jmp/0xz T_1.1, 5;
    %load/vec4 v0x34121730_0;
    %pad/s 4;
    %store/vec4 v0x34121810_0, 0, 4;
    %vpi_call/w 3 17 "$display", "in:%04b, out:%04b", v0x34121810_0, v0x34121900_0 {0 0 0};
    %delay 5, 0;
    %load/vec4 v0x34121730_0;
    %addi 1, 0, 32;
    %store/vec4 v0x34121730_0, 0, 32;
    %jmp T_1.0;
T_1.1 ;
    %delay 10, 0;
    %vpi_call/w 3 21 "$finish" {0 0 0};
    %end;
    .thread T_1;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "testbench.sv";
    "design.sv";
